# 이 파일은 키 "이름"만 보여주는 예시입니다 (실제 값 X, 커밋해도 안전).
# 실제 값은 .env.local 에 넣고, Vercel 배포 시 Environment Variables 에 동일하게 입력하세요.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://<your-project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# 서버 전용 (절대 NEXT_PUBLIC_ 붙이지 말 것). 결제 후 구독 발급에 필요.
# Supabase 대시보드 → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (AI 채점) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- 관리자 (쉼표로 여러 명 가능) ---
ADMIN_EMAILS=admin@example.com

# --- 포트원(PortOne) V2 ---
# 관리자콘솔 → 결제연동 → 연동 정보 에서 발급
# StoreID/ChannelKey는 공개돼도 되는 값(클라이언트), API Secret은 서버 전용(절대 NEXT_PUBLIC_ 금지)
NEXT_PUBLIC_PORTONE_STORE_ID=store-...
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=channel-key-...
PORTONE_API_SECRET=
