# 이 파일은 키 "이름"만 보여주는 예시입니다 (실제 값 X, 커밋해도 안전).
# 실제 값은 .env.local 에 넣고, Vercel 배포 시 Environment Variables 에 동일하게 입력하세요.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://<your-project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# 서버 전용 (절대 NEXT_PUBLIC_ 붙이지 말 것). 결제 후 구독 발급에 필요.
# Supabase 대시보드 → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (AI 채점) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- 관리자 (쉼표로 여러 명 가능) ---
ADMIN_EMAILS=admin@example.com

# --- 토스페이먼츠 ---
# 심사 통과 후 test_ -> live_ 키로 교체
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_...
TOSS_SECRET_KEY=test_sk_...
